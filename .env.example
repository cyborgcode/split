# Google Gemini — the only AI provider. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override. Default: gemini-3.5-flash-lite, falling back to
# gemini-3.1-flash-lite. Both Flash-Lite models have the largest free-tier
# quota of any Gemini text model (15 requests/min, 500/day each, counted per
# model — so the fallback doubles your daily budget).
GEMINI_MODEL=

# Sources for fact-check cards come from the keyless Wikipedia search API —
# nothing to configure.
